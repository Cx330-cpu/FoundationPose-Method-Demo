FROM nvidia/cuda:12.8.1-devel-ubuntu22.04

ARG UBUNTU_MIRROR=http://mirrors.aliyun.com/ubuntu

ENV DEBIAN_FRONTEND=noninteractive
ENV TZ=Asia/Shanghai
ENV OPENCV_IO_ENABLE_OPENEXR=1
ENV PYTHONNOUSERSITE=1
ENV TORCH_CUDA_ARCH_LIST=12.0
ENV FORCE_CUDA=1
ENV MAX_JOBS=1
ENV CMAKE_BUILD_PARALLEL_LEVEL=1
ENV NVCC_THREADS=1
ENV SHELL=/bin/bash

RUN ln -snf /usr/share/zoneinfo/$TZ /etc/localtime && echo $TZ > /etc/timezone

RUN sed -i "s|http://archive.ubuntu.com/ubuntu|${UBUNTU_MIRROR}|g; s|http://security.ubuntu.com/ubuntu|${UBUNTU_MIRROR}|g" /etc/apt/sources.list && \
    apt-get -o Acquire::Retries=5 -o Acquire::http::Timeout=30 update --fix-missing && \
    apt-get -o Acquire::Retries=5 -o Acquire::http::Timeout=30 install -y --no-install-recommends \
      bash build-essential ca-certificates cmake curl git g++ gcc \
      libboost-program-options-dev libboost-system-dev libeigen3-dev libgomp1 \
      libegl1 libgl1 libglib2.0-0 libglx0 libsm6 libxext6 libxrender1 \
      libxcb-xinerama0 libxkbcommon-x11-0 ninja-build pkg-config pybind11-dev \
      python3 python3-dev python3-pip python3-venv wget xauth && \
    rm -rf /var/lib/apt/lists/*

RUN ln -sf /usr/bin/python3 /usr/local/bin/python && \
    ln -sf /usr/bin/python3 /usr/local/bin/python3 && \
    python -m pip install --upgrade pip setuptools wheel

# RTX 50-series / Blackwell needs a PyTorch build with sm_120 support.
# Nightly torch/torchvision wheels are sometimes published a day apart, so
# install torchvision without re-solving the exact torch build date.
RUN python -m pip install --pre torch \
      --index-url https://download.pytorch.org/whl/nightly/cu128 && \
    python -m pip install --pre --no-deps torchvision \
      --index-url https://download.pytorch.org/whl/nightly/cu128

RUN python -m pip install \
      scipy joblib scikit-learn ruamel.yaml trimesh pyyaml imageio \
      transformations warp-lang einops pyrender scikit-image meshcat \
      webdataset omegaconf pypng roma seaborn openpyxl wandb imgaug xlsxwriter \
      albumentations xatlas rtree nodejs jupyterlab objaverse \
      pycocotools videoio numba h5py opencv-python

RUN python -m pip install kornia_rs huggingface_hub safetensors && \
    python -m pip install --no-deps kornia timm

RUN python -m pip install --no-deps ultralytics==8.0.120

# Open3D wheels can be large and occasionally conflict with pip's resolver;
# install it separately so rebuild failures point at the actual package.
RUN python -m pip install open3d

RUN cd /opt && \
    git clone --depth 1 https://github.com/facebookresearch/pytorch3d.git && \
    cd pytorch3d && \
    MAX_JOBS=1 CMAKE_BUILD_PARALLEL_LEVEL=1 NVCC_THREADS=1 python -m pip install --no-build-isolation .

RUN cd /opt && \
    git clone --recursive --depth 1 https://github.com/NVIDIAGameWorks/kaolin.git && \
    cd kaolin && \
    MAX_JOBS=1 CMAKE_BUILD_PARALLEL_LEVEL=1 NVCC_THREADS=1 FORCE_CUDA=1 python -m pip install --no-build-isolation -v .

RUN cd /opt && \
    git clone --depth 1 https://github.com/NVlabs/nvdiffrast.git && \
    cd nvdiffrast && \
    MAX_JOBS=1 CMAKE_BUILD_PARALLEL_LEVEL=1 NVCC_THREADS=1 python -m pip install --no-build-isolation .

RUN ln -sf /bin/bash /bin/sh

WORKDIR /workspace
